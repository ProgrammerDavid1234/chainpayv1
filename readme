.debug{color:rgba(255,255,255,.25);font-size:10px;text-align:center;margin-top:20px;word-break:break-all;max-width:360px}
</style>
</head>
<body>
<div class="logo">&#x1F517;</div>
<h1>Connect Wallet</h1>
<p class="sub">Sign a message with MetaMask to prove wallet ownership. No ETH is spent.</p>
<div class="msg-box">
  <div class="msg-label">Message to sign</div>
  <div class="msg-text" id="msgText">waiting...</div>
</div>
<button class="btn btn-primary" id="connectBtn" onclick="doConnect()" disabled>Connect MetaMask</button>
<button class="btn btn-secondary" onclick="doCancel()">Cancel</button>
<div class="status" id="status"></div>
<div class="debug" id="debug"></div>
<script src="https://cdn.jsdelivr.net/npm/@walletconnect/ethereum-provider@2.17.3/dist/index.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>
<script>
var sp = new URLSearchParams(location.search);
var hp = new URLSearchParams(location.hash.slice(1));
var nonce    = sp.get("nonce")    || hp.get("nonce")    || "";
var token    = sp.get("token")    || hp.get("token")    || "";
var redirect = sp.get("redirect") || hp.get("redirect") || "";
document.getElementById("debug").textContent = "URL: " + location.href;
if (nonce) {
  document.getElementById("msgText").textContent = "Link wallet to ChainPay account: " + nonce;
  document.getElementById("connectBtn").disabled = false;
} else {
  document.getElementById("msgText").textContent = "ERROR: No nonce in URL";
  setStatus("Missing nonce. Go back to app.", "error");
}
function setStatus(m, t) {
  var e = document.getElementById("status");
  e.textContent = m;
  e.className = "status " + t;
}
function doCancel() {
  if (redirect) location.href = redirect + "?cancelled=1";
  else window.close();
}
async function doConnect() {
  if (!nonce) return;
  var btn = document.getElementById("connectBtn");
  btn.disabled = true;
  btn.textContent = "Connecting...";
  try {
    var WCP = window.EthereumProvider || (window["@walletconnect/ethereum-provider"] && window["@walletconnect/ethereum-provider"].EthereumProvider);
    if (!WCP) throw new Error("WalletConnect SDK not loaded");
    setStatus("Opening MetaMask...", "info");
    var provider = await WCP.init({
      projectId: "b56e18d47c72ab683b10814fe9495694",
      chains: [11155111],
      showQrModal: true,
      metadata: { name: "ChainPay", description: "Blockchain wallet", url: location.origin, icons: [] }
    });
    await provider.connect();
    var ep = new ethers.providers.Web3Provider(provider);
    var signer = ep.getSigner();
    var address = await signer.getAddress();
    var message = "Link wallet to ChainPay account: " + nonce;
    setStatus("Sign the message in MetaMask...", "info");
    btn.textContent = "Waiting for signature...";
    var sig = await signer.signMessage(message);
    setStatus("Signed! Saving...", "success");
    var res = await fetch(location.origin + "/api/v1/wallet", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
      body: JSON.stringify({ walletAddress: address, signature: sig, message: message })
    });
    var json = await res.json();
    if (!res.ok && json.code !== "WALLET_EXISTS") throw new Error(json.error || "Server error");
    setStatus("Wallet linked! Returning to app...", "success");
    btn.textContent = "Done";
    setTimeout(function() {
      if (redirect) location.href = redirect + "?address=" + encodeURIComponent(address) + "&success=1";
    }, 1200);
  } catch(err) {
    var m = err.message || "Failed";
    var cancelled = ["closed","reject","cancel","denied"].some(function(w){ return m.toLowerCase().indexOf(w) !== -1; });
    setStatus(cancelled ? "Cancelled. Tap Try Again." : "Error: " + m, "error");
    btn.disabled = false;
    btn.textContent = "Try Again";
  }
}
</script>
</body>
</html>'''

with open('/root/Desktop/chainpay-backend/src/public/index.html', 'w') as f:
    f.write(html)
print("Done - lines:", html.count("\\n"))
