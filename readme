  <script src="https://cdn.jsdelivr.net/npm/@walletconnect/ethereum-provider@2.17.3/dist/index.umd.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>
  <script>
    var nonce    = new URLSearchParams(location.search).get('nonce')    || new URLSearchParams(location.hash.slice(1)).get('nonce')    || '';
    var token    = new URLSearchParams(location.search).get('token')    || new URLSearchParams(location.hash.slice(1)).get('token')    || '';
    var redirect = new URLSearchParams(location.search).get('redirect') || new URLSearchParams(location.hash.slice(1)).get('redirect') || '';

    document.getElementById('debug').textContent = 'URL: ' + location.href;

    if (nonce) {
      document.getElementById('msgText').textContent = 'Link wallet to ChainPay account: ' + nonce;
      document.getElementById('connectBtn').disabled = false;
    } else {
      document.getElementById('msgText').textContent = 'ERROR: No nonce in URL params';
      setStatus('Missing nonce. Go back to app and try again.', 'error');
    }

    function setStatus(m, t) { var e = document.getElementById('status'); e.textContent = m; e.className = 'status ' + t; }
    function doCancel() { if (redirect) location.href = redirect + '?cancelled=1'; else window.close(); }

    async function doConnect() {
      if (!nonce) return;
      var btn = document.getElementById('connectBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span>Connecting…';
      try {
        var WCP = window.EthereumProvider || (window['@walletconnect/ethereum-provider'] && window['@walletconnect/ethereum-provider'].EthereumProvider);
        if (!WCP) throw new Error('WalletConnect SDK not loaded');
        setStatus('Opening MetaMask…', 'info');
        var provider = await WCP.init({
          projectId: 'b56e18d47c72ab683b10814fe9495694',
          chains: [11155111],
          showQrModal: true,
          metadata: { name:'ChainPay', description:'Blockchain wallet', url: location.origin, icons:[] }
        });
        await provider.connect();
        var ethProvider = new ethers.providers.Web3Provider(provider);
        var signer  = ethProvider.getSigner();
        var address = await signer.getAddress();
        var message = 'Link wallet to ChainPay account: ' + nonce;
        setStatus('Sign the message in MetaMask…', 'info');
        btn.innerHTML = '<span class="spinner"></span>Waiting for signature…';
        var signature = await signer.signMessage(message);
        setStatus('Signed! Saving to server…', 'success');
        var res  = await fetch(location.origin + '/api/v1/wallet', {
          method: 'POST',
          headers: { 'Content-Type':'application/json', 'Authorization':'Bearer ' + token },
          body: JSON.stringify({ walletAddress: address, signature: signature, message: message })
        });
        var json = await res.json();
        if (!res.ok && json.code !== 'WALLET_EXISTS') throw new Error(json.error || 'Server error');
        setStatus('Wallet linked! Returning to app…', 'success');
        btn.innerHTML = '✓ Done';
        setTimeout(function() {
          if (redirect) location.href = redirect + '?address=' + encodeURIComponent(address) + '&success=1';
        }, 1200);
      } catch(err) {
        var m = err.message || 'Failed';
        setStatus(['closed','reject','cancel','denied'].some(function(w){return m.toLowerCase().includes(w);}) ? 'Cancelled. Tap Try Again.' : 'Error: ' + m, 'error');
        btn.disabled = false;
        btn.innerHTML = 'Try Again';
      }
    }
  </script>
</body>
</html>
